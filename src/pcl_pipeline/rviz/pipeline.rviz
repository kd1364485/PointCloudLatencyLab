Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 12
      Offset:
        X: 0
        Y: 0
        Z: -1.8
      Color: 90; 90; 90
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw (sensor/points)
      Enabled: true
      Topic:
        Value: /sensor/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 120; 120; 140
      Alpha: 0.6
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacles (ground_removed/points)
      Enabled: true
      Topic:
        Value: /ground_removed/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 170; 0
      Alpha: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Objects (objects/markers)
      Enabled: true
      Topic:
        Value: /objects/markers
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Enabled: true
  Global Options:
    Background Color: 25; 25; 30
    Fixed Frame: base_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 55
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 0.6
Window Geometry:
  Height: 800
  Width: 1200
